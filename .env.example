# Copia este archivo a .env (cp .env.example .env) y cambia las claves.
# .env NO se sube a GitHub.

POSTGRES_DB=bodega
POSTGRES_USER=bodega
POSTGRES_PASSWORD=cambia-esta-clave-de-bd

# Clave que el ESP32 manda en la cabecera X-API-Key (debe coincidir con firmware/.../secrets.h)
API_KEY=cambia-esta-api-key

# Puerto en el que se publica la app en tu PC
WEB_PORT=8000

# Umbrales de la bodega de café pergamino
TEMP_MIN=15
TEMP_MAX=25
HUM_MIN=50
HUM_MAX=65
